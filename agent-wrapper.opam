# This file is generated by dune, edit dune-project instead
opam-version: "2.0"
synopsis: "Safety checks, secret loading, and sandboxing for coding agents"
description:
  "A Unix command launcher with TOML-configured preconditions, file-backed environment variables, and optional Bubblewrap sandboxing."
maintainer: ["Akira Komamura"]
authors: ["Akira Komamura"]
license: "MIT"
homepage: "https://github.com/akirak/agent-wrapper"
bug-reports: "https://github.com/akirak/agent-wrapper/issues"
depends: [
  "dune" {>= "3.11"}
  "ocaml" {>= "4.13"}
  "cmdliner" {>= "1.1.0"}
  "otoml" {>= "1.0.5"}
  "odoc" {with-doc}
]
build: [
  ["dune" "subst"] {dev}
  [
    "dune"
    "build"
    "-p"
    name
    "-j"
    jobs
    "@install"
    "@runtest" {with-test}
    "@doc" {with-doc}
  ]
]
dev-repo: "git+https://github.com/akirak/agent-wrapper.git"
